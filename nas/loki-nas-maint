#!/usr/bin/python3
"""
loki-nas-maint — restricted read-only maintenance dispatcher for the UGREEN NAS.

Installed root-owned at /usr/local/sbin/loki-nas-maint and reachable only via a
single narrowly scoped sudoers rule. Loki calls it over SSH; it is the ONLY
privileged entry point the NAS exposes to dex247.

Contract:
  - argv is exactly one token, matched against a fixed action table. There is
    no path, container name, image, format string, Docker argument or shell
    fragment a caller can influence. Targets are discovered internally.
  - Only five read-only Docker verbs are ever executed: ps, inspect, logs
    (bounded), stats --no-stream, and events over a bounded past window
    (`--until 0s`, so it reads the journal and exits rather than streaming).
    No restart/stop/pull/exec/recreate exists in this file, so no input can
    reach one.
  - Output is JSON on stdout. Environment variable VALUES are never emitted —
    only their names. Labels are allowlisted. Log lines pass a redactor.

Exit codes: 0 ok · 2 unknown/malformed action · 3 discovery failed · 4 docker error
"""

import datetime
import json
import re
import subprocess
import sys

DOCKER = "/usr/bin/docker"
TIMEOUT = 25
LOG_TAIL = "80"          # fixed bound; not caller-influenced
MAX_LOG_CHARS = 6000

# Bounded exit-window log query. All fixed: no caller influences any of these.
PRE_EXIT_SECONDS = 480       # 8 minutes of context before the exit
POST_START_SECONDS = 240     # 4 minutes after the restart
PRE_LINE_CAP = 160           # lines kept immediately BEFORE the exit
POST_LINE_CAP = 60           # lines kept immediately AFTER the restart
LINE_CHAR_CAP = 400
# Descending tail depths tried when reading the exit window. Fixed list; a
# caller cannot influence it. Deepest first so we reach as far back as the log
# allows, falling back when a corrupted region blocks a deeper read.
TAIL_LADDER = (20000, 10000, 4000, 1500, 400, 100)

# Labels safe to echo verbatim. Anything else is dropped rather than guessed at,
# because vendor labels routinely carry connection strings and tokens.
SAFE_LABELS = (
    "com.docker.compose.project",
    "com.docker.compose.service",
    "com.docker.compose.project.config_files",
    "com.centurylinklabs.watchtower.enable",
    "org.opencontainers.image.title",
    "org.opencontainers.image.version",
    "org.opencontainers.image.revision",
    "org.opencontainers.image.source",
)

# Redaction applied to every log line and any free-text field.
_SECRET_PATTERNS = [
    # key=value / key: value for anything credential-shaped
    (re.compile(r"(?i)\b(pass(?:word|wd)?|secret|token|api[_-]?key|auth|"
                r"bearer|session|cookie|private[_-]?key)\b\s*[=:]\s*\S+"),
     r"\1=<REDACTED>"),
    # "Authorization: Bearer <token>" / bare "Bearer <token>"
    (re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]{8,}"), "Bearer <REDACTED>"),
    # credentials embedded in a URL: scheme://user:pass@host
    (re.compile(r"\b([a-z][a-z0-9+.-]*://)[^:/\s@]+:[^@\s]+@"), r"\1<REDACTED>@"),
    # bare long tokens (JWT-ish / hex / base64 blobs)
    (re.compile(r"\b[A-Za-z0-9_-]{32,}\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}\b"),
     "<REDACTED-JWT>"),
    # Bare hex blobs, but NOT content-addressable digests (sha256:… , @sha256:…)
    # or git revisions — those are public provenance and are exactly what an
    # update check needs to compare.
    (re.compile(r"(?<![:@])\b[0-9a-f]{40,}\b"), "<REDACTED-HEX>"),
]


def redact(text):
    if not isinstance(text, str):
        return text
    for pat, repl in _SECRET_PATTERNS:
        text = pat.sub(repl, text)
    return text


def fail(code, message):
    print(json.dumps({"ok": False, "error": message}))
    sys.exit(code)


def docker_try(*args, timeout=TIMEOUT):
    """Like docker(), but returns (ok, stdout, stderr) instead of exiting.

    Needed where a failure is expected and recoverable — notably reading logs
    from a json-file that has a corrupted region."""
    try:
        p = subprocess.run([DOCKER, *args], capture_output=True, text=True,
                           timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, "", "timeout"
    except OSError as e:
        return False, "", e.__class__.__name__
    return p.returncode == 0, p.stdout, redact(p.stderr.strip())[:300]


def docker(*args, timeout=TIMEOUT):
    """Run a fixed docker argv. Never a shell, never caller-supplied strings."""
    try:
        p = subprocess.run([DOCKER, *args], capture_output=True, text=True,
                           timeout=timeout)
    except subprocess.TimeoutExpired:
        fail(4, "docker command timed out")
    except OSError as e:
        fail(4, f"cannot execute docker: {e.__class__.__name__}")
    if p.returncode != 0:
        fail(4, f"docker {args[0]} failed: {redact(p.stderr.strip())[:200]}")
    return p.stdout


# ── discovery ──────────────────────────────────────────────────────────────
def ps_all():
    """Every container (running + stopped) as dicts, from a fixed format."""
    out = docker("ps", "--all", "--no-trunc", "--format", "{{json .}}")
    rows = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except ValueError:
            continue
    return rows


def parse_labels(raw):
    """docker ps gives labels as k=v,k=v. Keep only the allowlist."""
    keep = {}
    for part in (raw or "").split(","):
        if "=" not in part:
            continue
        k, v = part.split("=", 1)
        if k in SAFE_LABELS:
            keep[k] = redact(v)
    return keep


def inspect(cid):
    """Narrowly scoped inspect: one discovered id, whitelisted fields only."""
    raw = docker("inspect", cid)
    try:
        data = json.loads(raw)[0]
    except (ValueError, IndexError, KeyError):
        fail(4, "could not parse docker inspect output")
    state = data.get("State") or {}
    health = (state.get("Health") or {}).get("Status")
    cfg = data.get("Config") or {}
    net = (data.get("NetworkSettings") or {}).get("Networks") or {}
    networks = {}
    for name, n in net.items():
        networks[name] = {"ip": (n or {}).get("IPAddress") or None,
                          "aliases": [a for a in ((n or {}).get("Aliases") or [])]}
    labels = {k: redact(v) for k, v in (cfg.get("Labels") or {}).items()
              if k in SAFE_LABELS}
    return {
        "name": (data.get("Name") or "").lstrip("/"),
        "id_short": (data.get("Id") or "")[:12],
        "image": redact(cfg.get("Image") or ""),
        # Content-addressable id of the image actually running. Kept verbatim:
        # it is a valid docker reference, so later actions resolve the image by
        # THIS rather than by the redacted display string.
        "image_id": data.get("Image") or "",
        "image_digest": (data.get("Image") or "")[:19],
        "created": data.get("Created"),
        "state": state.get("Status"),
        "running": bool(state.get("Running")),
        "started_at": state.get("StartedAt"),
        "restart_count": data.get("RestartCount"),
        "health": health,
        "exit_code": state.get("ExitCode"),
        "oom_killed": state.get("OOMKilled"),
        "restart_policy": ((data.get("HostConfig") or {}).get("RestartPolicy")
                           or {}).get("Name"),
        # NAMES ONLY — values are secrets by default.
        "env_var_names": sorted({e.split("=", 1)[0]
                                 for e in (cfg.get("Env") or []) if "=" in e}),
        "labels": labels,
        "networks": networks,
    }


def find_tracearr(rows):
    """Identify Tracearr without trusting any caller input.

    Evidence, in order: compose service/project label, image reference, the
    published 3001 port, then container name. First match wins."""
    for row in rows:
        labels = parse_labels(row.get("Labels"))
        hay = " ".join([
            labels.get("com.docker.compose.service", ""),
            labels.get("com.docker.compose.project", ""),
            labels.get("org.opencontainers.image.title", ""),
            row.get("Image", ""), row.get("Names", ""),
        ]).lower()
        if "tracearr" in hay:
            return row
    for row in rows:
        if ":3001->" in (row.get("Ports") or ""):
            return row
    return None


def project_of(row):
    return parse_labels(row.get("Labels")).get("com.docker.compose.project")


def siblings(rows, project):
    if not project:
        return []
    return [r for r in rows if project_of(r) == project]


def classify(row):
    """Role of a container from its image + compose service name."""
    labels = parse_labels(row.get("Labels"))
    svc = labels.get("com.docker.compose.service", "").lower()
    image = (row.get("Image") or "").lower()
    blob = f"{svc} {image}"
    if "redis" in blob or "valkey" in blob:
        return "redis"
    if "timescale" in blob or "postgres" in blob or "pgvector" in blob:
        return "postgres"
    if "tracearr" in blob:
        return "tracearr"
    return "other"


def tracearr_or_die(rows):
    row = find_tracearr(rows)
    if row is None:
        fail(3, "Tracearr container not found by label, image, port or name")
    return row


def stack(rows):
    """The Tracearr container plus its compose siblings, classified."""
    app = tracearr_or_die(rows)
    project = project_of(app)
    members = siblings(rows, project) or [app]
    found = {"tracearr": None, "redis": None, "postgres": None, "other": []}
    for r in members:
        role = classify(r)
        if role == "other":
            found["other"].append(r)
        elif found[role] is None:
            found[role] = r
    if found["tracearr"] is None:
        found["tracearr"] = app
    return project, found


# ── actions ────────────────────────────────────────────────────────────────
def act_host_status():
    def read(path):
        try:
            with open(path) as f:
                return f.read()
        except OSError:
            return ""
    mem = {}
    for line in read("/proc/meminfo").splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            if k in ("MemTotal", "MemAvailable", "SwapTotal", "SwapFree"):
                mem[k] = v.strip()
    df = subprocess.run(["/bin/df", "-h", "/", "/volume1", "/volume2"],
                        capture_output=True, text=True, timeout=15)
    disks = []
    for line in df.stdout.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 6:
            disks.append({"fs": parts[0][:40], "size": parts[1], "used": parts[2],
                          "avail": parts[3], "use_pct": parts[4], "mount": parts[5]})
    rows = ps_all()
    return {"uptime_seconds": int(float((read("/proc/uptime") or "0").split()[0] or 0)),
            "memory": mem, "disks": disks,
            "containers_total": len(rows),
            "containers_running": sum(1 for r in rows
                                      if (r.get("State") or "") == "running")}


def act_container_inventory():
    out = []
    for r in ps_all():
        labels = parse_labels(r.get("Labels"))
        out.append({"name": r.get("Names"), "state": r.get("State"),
                    "status": redact(r.get("Status") or ""),
                    "image": redact(r.get("Image") or ""),
                    "compose_project": labels.get("com.docker.compose.project"),
                    "compose_service": labels.get("com.docker.compose.service")})
    out.sort(key=lambda c: (c["compose_project"] or "~", c["name"] or ""))
    return {"containers": out, "count": len(out)}


def act_tracearr_status():
    rows = ps_all()
    project, found = stack(rows)
    app = inspect(found["tracearr"]["ID"])
    stats = _stats([found["tracearr"]["ID"]])
    return {"compose_project": project, "tracearr": app,
            "resource_usage": stats}


def act_tracearr_dependencies():
    rows = ps_all()
    project, found = stack(rows)
    result = {"compose_project": project, "dependencies": {}}
    for role in ("tracearr", "redis", "postgres"):
        row = found.get(role)
        result["dependencies"][role] = inspect(row["ID"]) if row else None
    # Network relationship: which networks the app shares with each dependency.
    app_nets = set((result["dependencies"]["tracearr"] or {}).get("networks", {}))
    shared = {}
    for role in ("redis", "postgres"):
        dep = result["dependencies"][role]
        shared[role] = sorted(app_nets & set((dep or {}).get("networks", {})))
    result["shared_networks"] = shared
    result["other_stack_members"] = [r.get("Names") for r in found["other"]]
    return result


def act_tracearr_recent_logs():
    rows = ps_all()
    _, found = stack(rows)
    logs = {}
    for role in ("tracearr", "redis", "postgres"):
        row = found.get(role)
        if not row:
            logs[role] = None
            continue
        out = docker("logs", "--tail", LOG_TAIL, "--timestamps", row["ID"])
        lines = [redact(ln) for ln in out.splitlines()]
        blob = "\n".join(lines)[-MAX_LOG_CHARS:]
        logs[role] = {"container": row.get("Names"),
                      "lines_returned": len(lines),
                      "tail": blob}
    return {"logs": logs, "tail_limit": int(LOG_TAIL)}


def act_tracearr_update_check():
    """Local image provenance only. This dispatcher never contacts a registry
    and never pulls; a real version comparison is the caller's job."""
    rows = ps_all()
    project, found = stack(rows)
    out = {"compose_project": project, "images": {}}
    for role in ("tracearr", "redis", "postgres"):
        row = found.get(role)
        if not row:
            out["images"][role] = None
            continue
        d = inspect(row["ID"])
        # Resolve by image id, never by the redacted display string.
        raw = docker("image", "inspect", d["image_id"])
        try:
            img = json.loads(raw)[0]
        except (ValueError, IndexError):
            img = {}
        out["images"][role] = {
            "container": d["name"],
            "image": d["image"],
            "image_created": img.get("Created"),
            "repo_digests": [rd[:60] for rd in (img.get("RepoDigests") or [])],
            "container_started": d["started_at"],
            "watchtower_enabled":
                d["labels"].get("com.centurylinklabs.watchtower.enable"),
        }
    out["note"] = ("local image metadata only — no registry query, no pull. "
                   "Watchtower on the NAS performs actual updates.")
    return out


def act_tracearr_restart_forensics():
    """Read-only evidence for WHY the app container keeps restarting.

    Distinguishes an application exit (docker records die→start and bumps
    RestartCount) from an external `docker restart`, a healthcheck action, or
    an internal maintenance cycle that never exits the process."""
    rows = ps_all()
    project, found = stack(rows)
    app = found["tracearr"]
    raw = docker("inspect", app["ID"])
    try:
        data = json.loads(raw)[0]
    except (ValueError, IndexError):
        fail(4, "could not parse docker inspect output")
    state = data.get("State") or {}
    health = state.get("Health") or {}
    cfg = data.get("Config") or {}
    hc = cfg.get("Healthcheck") or {}
    # Healthcheck probe history: exit codes and bounded, redacted output.
    log = []
    for entry in (health.get("Log") or [])[-6:]:
        log.append({"start": entry.get("Start"), "end": entry.get("End"),
                    "exit_code": entry.get("ExitCode"),
                    "output": redact((entry.get("Output") or "").strip())[:300]})
    # Container-scoped docker events over a bounded window. Read-only: this
    # only reads the daemon's event journal, it never acts on the container.
    #
    # KNOWN LIMITATION — read before trusting an empty `events` list.
    # `docker events --since` is served from an IN-MEMORY ring buffer (~256
    # entries), not a persisted log. Every healthchecked container emits three
    # exec_* events per probe, so on a host with several 10-30s healthchecks
    # the buffer turns over in MINUTES. Asking for 48h returns only the last
    # few minutes, and lifecycle events (die/start/restart) age out long before
    # a caller sees them. Measured 2026-07-27 on dex247: 254 events for a
    # requested 48h window, 100% of them exec_*, zero lifecycle events across
    # 33 containers.
    #
    # Therefore an empty `events` list is NOT evidence that no restart
    # happened. Use events_raw_count / events_raw_first_ts below to see how far
    # back the buffer actually reached, and treat State.FinishedAt +
    # RestartCount as the authoritative restart evidence instead.
    events = []
    ev_error = None
    # Instrumentation: an empty `events` list is ambiguous on its own — it can
    # mean the daemon's event ring buffer is too shallow to reach a restart, or
    # that the container filter matched nothing at all. These counters tell the
    # two apart without another round trip.
    raw_count = 0
    exec_excluded = 0
    raw_first = raw_last = None
    try:
        # Scope by container ID, not name: a name filter PREFIX-matches, so
        # "tracearr" would also sweep in tracearr-db and tracearr-redis.
        raw_ev = docker("events", "--since", "48h", "--until", "0s",
                        "--filter", f"container={data.get('Id') or ''}",
                        "--filter", "type=container",
                        "--format", "{{json .}}", timeout=40)
        for line in raw_ev.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            raw_count += 1
            ts = e.get("time")
            if ts is not None:
                raw_first = ts if raw_first is None else min(raw_first, ts)
                raw_last = ts if raw_last is None else max(raw_last, ts)
            action = e.get("Action") or ""
            # Healthcheck probes fire every 30s and would otherwise crowd the
            # lifecycle events we actually need out of the window.
            if action.startswith("exec_"):
                exec_excluded += 1
                continue
            attrs = (e.get("Actor") or {}).get("Attributes") or {}
            events.append({
                "action": action,
                "time": e.get("time"),
                "time_nano": e.get("timeNano"),
                "exit_code": attrs.get("exitCode"),
                "signal": attrs.get("signal"),
            })
    except SystemExit:
        raise
    except Exception as e:                      # events unsupported / no journal
        ev_error = e.__class__.__name__
    return {
        "compose_project": project,
        "container": app.get("Names"),
        "container_id": (data.get("Id") or "")[:12],
        "container_created": data.get("Created"),
        "state": {
            "status": state.get("Status"),
            "running": state.get("Running"),
            "restarting": state.get("Restarting"),
            "started_at": state.get("StartedAt"),
            "finished_at": state.get("FinishedAt"),
            "exit_code": state.get("ExitCode"),
            "error": redact(state.get("Error") or ""),
            "oom_killed": state.get("OOMKilled"),
            "pid": state.get("Pid"),
        },
        "restart_count": data.get("RestartCount"),
        "restart_policy": ((data.get("HostConfig") or {}).get("RestartPolicy")
                           or {}).get("Name"),
        "healthcheck": {
            # The probe command is config, not a secret, but redact anyway in
            # case a URL with credentials was baked into it.
            "test": [redact(str(t)) for t in (hc.get("Test") or [])],
            "interval_ns": hc.get("Interval"),
            "timeout_ns": hc.get("Timeout"),
            "retries": hc.get("Retries"),
            "start_period_ns": hc.get("StartPeriod"),
            "status": health.get("Status"),
            "failing_streak": health.get("FailingStreak"),
            "log": log,
        },
        "events": events[-60:],
        "events_window": "48h, lifecycle only (exec_* healthcheck probes excluded)",
        "events_raw_count": raw_count,
        "events_exec_excluded": exec_excluded,
        "events_raw_first_ts": raw_first,
        "events_raw_last_ts": raw_last,
        "events_error": ev_error,
        "note": ("RestartCount increments only for restart-policy restarts "
                 "after the process exits; a manual `docker restart` does not "
                 "increment it. An EMPTY events list proves nothing: the "
                 "daemon's event ring buffer (~256 entries) is exhausted by "
                 "healthcheck exec_* probes within minutes, so lifecycle "
                 "events age out. Compare events_raw_first_ts against the "
                 "requested window before drawing any conclusion."),
    }


def act_tracearr_exit_window_logs():
    """Persisted logs bracketing the LAST container exit.

    docker logs is written to disk by the json-file driver and survives
    restarts, so unlike the event ring buffer it can still answer what the
    application was doing when it exited. The window is derived internally
    from State.FinishedAt/StartedAt — a caller supplies nothing.
    """
    rows = ps_all()
    _project, found = stack(rows)
    app = found["tracearr"]
    raw = docker("inspect", app["ID"])
    try:
        data = json.loads(raw)[0]
    except (ValueError, IndexError):
        fail(4, "could not parse docker inspect output")
    state = data.get("State") or {}
    fin, sta = state.get("FinishedAt"), state.get("StartedAt")
    if not fin or fin.startswith("0001-01-01"):
        fail(3, "container has no recorded FinishedAt — it has never exited")

    def _parse(ts):
        # RFC3339 with variable fractional digits; trim to microseconds.
        t = (ts or "").replace("Z", "+00:00")
        if "." in t:
            head, rest = t.split(".", 1)
            frac = "".join(c for c in rest if c.isdigit())[:6]
            tz = rest[len(frac):] if not rest[len(frac):].isdigit() else "+00:00"
            t = f"{head}.{frac.ljust(6, '0')}{tz or '+00:00'}"
        return datetime.datetime.fromisoformat(t)

    try:
        f_dt = _parse(fin)
        s_dt = _parse(sta) if sta else f_dt
    except ValueError:
        fail(3, "could not parse container timestamps")

    since = (f_dt - datetime.timedelta(seconds=PRE_EXIT_SECONDS))
    until = (s_dt + datetime.timedelta(seconds=POST_START_SECONDS))
    fmt = "%Y-%m-%dT%H:%M:%SZ"

    # This container's json-file log has a CORRUPTED region: a --since/--until
    # query makes the daemon scan forward from an offset and it dies with
    #   Error grabbing logs: invalid character '\x00' looking for beginning of value
    # Reading BACKWARD with --tail avoids that region entirely, so take a tail
    # and filter to the window here. Walk a descending ladder so a corruption
    # that sits inside a deep tail degrades to a shallower one instead of
    # failing outright.
    out, used_tail, corruption, last_err = "", None, False, ""
    for cap in TAIL_LADDER:
        ok, text, err = docker_try("logs", "--timestamps", "--tail", str(cap),
                                   app["ID"], timeout=60)
        if ok:
            out, used_tail = text, cap
            break
        last_err = err
        if "\\x00" in err or "invalid character" in err:
            corruption = True
        continue
    if used_tail is None:
        fail(4, f"could not read logs at any tail depth {list(TAIL_LADDER)}: "
                f"{last_err}")

    pre, post = [], []
    for line in out.splitlines():
        line = redact(line.rstrip())[:LINE_CHAR_CAP]
        if not line:
            continue
        stamp = line.split(" ", 1)[0]
        try:
            when = _parse(stamp)
        except (ValueError, IndexError):
            # Unstamped continuation line: attribute it to the side we are on.
            (post if post else pre).append(line)
            continue
        (pre if when <= f_dt else post).append(line)
    # Only keep pre-exit lines inside the window, and record whether the tail
    # reached far enough back to cover it.
    window_reached = False
    if pre:
        try:
            oldest = _parse(pre[0].split(" ", 1)[0])
            window_reached = oldest <= since
        except (ValueError, IndexError):
            window_reached = False
    truncated = len(pre) > PRE_LINE_CAP or len(post) > POST_LINE_CAP
    return {
        "container": app.get("Names"),
        "window_since": since.astimezone(datetime.timezone.utc).strftime(fmt),
        "window_until": until.astimezone(datetime.timezone.utc).strftime(fmt),
        "finished_at": fin,
        "started_at": sta,
        "restart_count": data.get("RestartCount"),
        # Lines closest to the exit are the interesting ones, so keep the TAIL
        # of the pre-exit side and the HEAD of the post-start side.
        "pre_exit_lines": pre[-PRE_LINE_CAP:],
        "post_start_lines": post[:POST_LINE_CAP],
        "pre_exit_total": len(pre),
        "post_start_total": len(post),
        "truncated": truncated,
        "tail_depth_used": used_tail,
        # True when a deeper read was rejected by the NUL-corrupted region.
        "log_corruption_detected": corruption,
        # Did the tail actually reach back past the start of the window? If
        # false, the pre-exit context is incomplete and must not be read as
        # "nothing happened before the exit".
        "window_reached": window_reached,
        "note": ("persisted json-file logs read BACKWARD via --tail, because a "
                 "--since/--until scan hits a corrupted (NUL) region in this "
                 "container's json-file log. Window derived internally from "
                 "State.FinishedAt/StartedAt."),
    }


def _stats(ids):
    """docker stats --no-stream over discovered ids only."""
    out = docker("stats", "--no-stream", "--format", "{{json .}}", *ids)
    rows = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            s = json.loads(line)
        except ValueError:
            continue
        rows.append({"name": s.get("Name"), "cpu_pct": s.get("CPUPerc"),
                     "mem_usage": s.get("MemUsage"), "mem_pct": s.get("MemPerc"),
                     "pids": s.get("PIDs")})
    return rows


ACTIONS = {
    "host_status": act_host_status,
    "container_inventory": act_container_inventory,
    "tracearr_status": act_tracearr_status,
    "tracearr_dependencies": act_tracearr_dependencies,
    "tracearr_recent_logs": act_tracearr_recent_logs,
    "tracearr_update_check": act_tracearr_update_check,
    "tracearr_restart_forensics": act_tracearr_restart_forensics,
    "tracearr_exit_window_logs": act_tracearr_exit_window_logs,
}


def main():
    argv = sys.argv[1:]
    if len(argv) != 1:
        fail(2, f"exactly one action required; known: {sorted(ACTIONS)}")
    action = argv[0]
    # Strict token: no paths, flags, separators or shell metacharacters survive.
    if not re.fullmatch(r"[a-z][a-z0-9_]{2,39}", action) or action not in ACTIONS:
        fail(2, f"unknown action; known: {sorted(ACTIONS)}")
    payload = ACTIONS[action]()
    print(json.dumps({"ok": True, "action": action, "data": payload},
                     default=str))


if __name__ == "__main__":
    main()
