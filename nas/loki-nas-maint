DOCKER = "/usr/bin/docker"
TIMEOUT = 25
LOG_TAIL = "80"          # fixed bound; not caller-influenced
MAX_LOG_CHARS = 6000

# ── network / disk / Plex diagnostics (Pass 3) — all fixed constants ───────
IPERF3 = "/usr/bin/iperf3"       # already present on the NAS (confirmed live)
IPERF3_PORT = 5201                            # fixed port, never caller-supplied
IPERF3_SERVER_TIMEOUT = 15                    # hard wall-clock cap
THROUGHPUT_SAMPLE_SECONDS = 2                 # fixed sampling window
PING_COUNT = "3"
PING_TIMEOUT = "2"
DMESG_LINE_CAP = 40
PLEX_PORT = 32400
SAFE_MOUNT_PREFIXES = ("/volume1", "/volume2", "/mnt")  # only these are df'd

# Bounded exit-window log query. All fixed: no caller influences any of these.
PRE_EXIT_SECONDS = 480       # 8 minutes of context before the exit
POST_START_SECONDS = 240     # 4 minutes after the restart
PRE_LINE_CAP = 160           # lines kept immediately BEFORE the exit
POST_LINE_CAP = 60           # lines kept immediately AFTER the restart
LINE_CHAR_CAP = 400          # ordinary log lines stay tight
# Error-level lines only: enough to carry a complete Drizzle/PostgreSQL error
# object. Bounded, and capped in count by MAX_ERROR_OBJECTS so total output
# cannot grow with log volume.
ERROR_LINE_CHAR_CAP = 2000
SQL_CONTEXT_CAP = 600
ERROR_REASON_CAP = 300
MAX_ERROR_OBJECTS = 5
# Descending tail depths tried when reading the exit window. Fixed list; a
# caller cannot influence it. Deepest first so we reach as far back as the log
# allows, falling back when a corrupted region blocks a deeper read.
TAIL_LADDER = (20000, 10000, 4000, 1500, 400, 100)

# ── Update / backup / rollback (STATE-CHANGING, approval-gated) ────────────
# Everything below is a FIXED constant. The only values a caller may supply
# are a content digest and a prepare id, each matched against a strict regex;
# no repository, container, path, tag or Docker argument ever crosses the
# boundary. The repository is pinned here, so an approved digest can only ever
# be pulled from this one repo.
TRACEARR_REPO = "ghcr.io/connorgallopo/tracearr"
STATE_DIR = "/var/lib/loki-nas-maint"
STATE_FILE = STATE_DIR + "/tracearr_update.json"
BACKUP_ROOT = "/volume2/loki-backups/tracearr"
# Bounded readiness wait used by BOTH post-update and post-rollback
# verification. Deliberately shorter than the client's 240s verify timeout so
# the dispatcher always returns a structured verdict rather than being killed.
READINESS_DEADLINE_SECONDS = 150
READINESS_POLL_SECONDS = 5
LOCAL_HEALTH_URL = "http://127.0.0.1:3001/health"
PUBLIC_HEALTH_URL = "https://tracearr.ivn-group.cc/health"
MIN_FREE_MB = 2048
DIGEST_RE = re.compile(r"^sha256:[0-9a-f]{64}$")
PREPARE_ID_RE = re.compile(r"^[0-9a-f]{16}$")

# Labels safe to echo verbatim. Anything else is dropped rather than guessed at,
# because vendor labels routinely carry connection strings and tokens.
SAFE_LABELS = (
    "com.docker.compose.project",
    "com.docker.compose.service",
    "com.docker.compose.project.config_files",
    "com.centurylinklabs.watchtower.enable",
    "org.opencontainers.image.title",
    "org.opencontainers.image.version",
    "org.opencontainers.image.revision",
    "org.opencontainers.image.source",
)

# Redaction applied to every log line and any free-text field.
_SECRET_PATTERNS = [
    # key=value / key: value for anything credential-shaped
    (re.compile(r"(?i)\b(pass(?:word|wd)?|secret|token|api[_-]?key|auth|"
                r"bearer|session|cookie|private[_-]?key)\b\s*[=:]\s*\S+"),
     r"\1=<REDACTED>"),
    # "Authorization: Bearer <token>" / bare "Bearer <token>"
    (re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]{8,}"), "Bearer <REDACTED>"),
    # credentials embedded in a URL: scheme://user:pass@host
    (re.compile(r"\b([a-z][a-z0-9+.-]*://)[^:/\s@]+:[^@\s]+@"), r"\1<REDACTED>@"),
    # bare long tokens (JWT-ish / hex / base64 blobs)
    (re.compile(r"\b[A-Za-z0-9_-]{32,}\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}\b"),
     "<REDACTED-JWT>"),
    # Bare hex blobs, but NOT content-addressable digests (sha256:… , @sha256:…)
    # or git revisions — those are public provenance and are exactly what an
    # update check needs to compare.
    (re.compile(r"(?<![:@])\b[0-9a-f]{40,}\b"), "<REDACTED-HEX>"),
]


def redact(text):
    if not isinstance(text, str):
        return text
    for pat, repl in _SECRET_PATTERNS:
        text = pat.sub(repl, text)
    return text


def fail(code, message):
    print(json.dumps({"ok": False, "error": message}))
    sys.exit(code)


def docker_try(*args, timeout=TIMEOUT):
    """Like docker(), but returns (ok, stdout, stderr) instead of exiting.

    Needed where a failure is expected and recoverable — notably reading logs
    from a json-file that has a corrupted region."""
    try:
        p = subprocess.run([DOCKER, *args], capture_output=True, text=True,
                           timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, "", "timeout"
    except OSError as e:
        return False, "", e.__class__.__name__
    return p.returncode == 0, p.stdout, redact(p.stderr.strip())[:300]


def docker(*args, timeout=TIMEOUT):
    """Run a fixed docker argv. Never a shell, never caller-supplied strings."""
    try:
        p = subprocess.run([DOCKER, *args], capture_output=True, text=True,
                           timeout=timeout)
    except subprocess.TimeoutExpired:
        fail(4, "docker command timed out")
    except OSError as e:
        fail(4, f"cannot execute docker: {e.__class__.__name__}")
    if p.returncode != 0:
        fail(4, f"docker {args[0]} failed: {redact(p.stderr.strip())[:200]}")
    return p.stdout


# ── discovery ──────────────────────────────────────────────────────────────
def ps_all():
    """Every container (running + stopped) as dicts, from a fixed format."""
    out = docker("ps", "--all", "--no-trunc", "--format", "{{json .}}")
    rows = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except ValueError:
            continue
    return rows


def parse_labels(raw):
    """docker ps gives labels as k=v,k=v. Keep only the allowlist."""
    keep = {}
    for part in (raw or "").split(","):
        if "=" not in part:
            continue
        k, v = part.split("=", 1)
        if k in SAFE_LABELS:
            keep[k] = redact(v)
    return keep


def inspect(cid):
    """Narrowly scoped inspect: one discovered id, whitelisted fields only."""
    raw = docker("inspect", cid)
    try:
        data = json.loads(raw)[0]
    except (ValueError, IndexError, KeyError):
        fail(4, "could not parse docker inspect output")
    state = data.get("State") or {}
    health = (state.get("Health") or {}).get("Status")
    cfg = data.get("Config") or {}
    net = (data.get("NetworkSettings") or {}).get("Networks") or {}
    networks = {}
    for name, n in net.items():
        networks[name] = {"ip": (n or {}).get("IPAddress") or None,
                          "aliases": [a for a in ((n or {}).get("Aliases") or [])]}
    labels = {k: redact(v) for k, v in (cfg.get("Labels") or {}).items()
              if k in SAFE_LABELS}
    return {
        "name": (data.get("Name") or "").lstrip("/"),
        "id_short": (data.get("Id") or "")[:12],
        "image": redact(cfg.get("Image") or ""),
        # Content-addressable id of the image actually running. Kept verbatim:
        # it is a valid docker reference, so later actions resolve the image by
        # THIS rather than by the redacted display string.
        "image_id": data.get("Image") or "",
        "image_digest": (data.get("Image") or "")[:19],
        "created": data.get("Created"),
        "state": state.get("Status"),
        "running": bool(state.get("Running")),
        "started_at": state.get("StartedAt"),
        "restart_count": data.get("RestartCount"),
        "health": health,
        "exit_code": state.get("ExitCode"),
        "oom_killed": state.get("OOMKilled"),
        "restart_policy": ((data.get("HostConfig") or {}).get("RestartPolicy")
                           or {}).get("Name"),
        # NAMES ONLY — values are secrets by default.
        "env_var_names": sorted({e.split("=", 1)[0]
                                 for e in (cfg.get("Env") or []) if "=" in e}),
        "labels": labels,
        "networks": networks,
    }


def find_tracearr(rows):
    """Identify Tracearr without trusting any caller input.

    Evidence, in order: compose service/project label, image reference, the
    published 3001 port, then container name. First match wins."""
    for row in rows:
        labels = parse_labels(row.get("Labels"))
        hay = " ".join([
            labels.get("com.docker.compose.service", ""),
            labels.get("com.docker.compose.project", ""),
            labels.get("org.opencontainers.image.title", ""),
            row.get("Image", ""), row.get("Names", ""),
        ]).lower()
        if "tracearr" in hay:
            return row
    for row in rows:
        if ":3001->" in (row.get("Ports") or ""):
            return row
    return None


def project_of(row):
    return parse_labels(row.get("Labels")).get("com.docker.compose.project")


def siblings(rows, project):
    if not project:
        return []
    return [r for r in rows if project_of(r) == project]


def classify(row):
    """Role of a container from its image + compose service name."""
    labels = parse_labels(row.get("Labels"))
    svc = labels.get("com.docker.compose.service", "").lower()
    image = (row.get("Image") or "").lower()
    blob = f"{svc} {image}"
    if "redis" in blob or "valkey" in blob:
        return "redis"
    if "timescale" in blob or "postgres" in blob or "pgvector" in blob:
        return "postgres"
    if "tracearr" in blob:
        return "tracearr"
    return "other"


def tracearr_or_die(rows):
    row = find_tracearr(rows)
    if row is None:
        fail(3, "Tracearr container not found by label, image, port or name")
    return row


def stack(rows):
    """The Tracearr container plus its compose siblings, classified."""
    app = tracearr_or_die(rows)
    project = project_of(app)
    members = siblings(rows, project) or [app]
    found = {"tracearr": None, "redis": None, "postgres": None, "other": []}
    for r in members:
        role = classify(r)
        if role == "other":
            found["other"].append(r)
        elif found[role] is None:
            found[role] = r
    if found["tracearr"] is None:
        found["tracearr"] = app
    return project, found


# ── network discovery (Pass 3) ──────────────────────────────────────────────
def _run(*args, timeout=15):
    """Fixed argv, non-docker system tool. Returns (ok, stdout, stderr)."""
    try:
        p = subprocess.run(list(args), capture_output=True, text=True,
                           timeout=timeout)
        return p.returncode == 0, p.stdout, redact(p.stderr.strip())[:300]
    except subprocess.TimeoutExpired:
        return False, "", "timeout"
    except OSError as e:
        return False, "", e.__class__.__name__


def _default_route():
    """Active default-route interface and gateway, discovered — never hardcoded."""
    ok, out, _ = _run("/sbin/ip", "-j", "route", "show", "default")
    if not ok:
        ok, out, _ = _run("/usr/sbin/ip", "-j", "route", "show", "default")
    try:
        routes = json.loads(out or "[]")
    except ValueError:
        routes = []
    for r in routes:
        if r.get("dst") == "default" and r.get("dev"):
            return r.get("dev"), r.get("gateway")
    return None, None


def _iface_addr(iface):
    ok, out, _ = _run("/sbin/ip", "-j", "-4", "addr", "show", "dev", iface)
    if not ok:
        ok, out, _ = _run("/usr/sbin/ip", "-j", "-4", "addr", "show", "dev", iface)
    try:
        data = json.loads(out or "[]")
    except ValueError:
        return None
    for entry in data:
        for a in entry.get("addr_info") or []:
            if a.get("family") == "inet":
                return a.get("local")
    return None


def _read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def _read_str(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def _iface_stats(iface):
    base = f"/sys/class/net/{iface}"
    stats_base = f"{base}/statistics"
    return {
        "speed_mbps": _read_int(f"{base}/speed"),
        "duplex": _read_str(f"{base}/duplex"),
        "mtu": _read_int(f"{base}/mtu"),
        "carrier": _read_int(f"{base}/carrier"),
        "carrier_changes": _read_int(f"{base}/carrier_changes"),
        "operstate": _read_str(f"{base}/operstate"),
        "rx_bytes": _read_int(f"{stats_base}/rx_bytes"),
        "tx_bytes": _read_int(f"{stats_base}/tx_bytes"),
        "rx_errors": _read_int(f"{stats_base}/rx_errors"),
        "tx_errors": _read_int(f"{stats_base}/tx_errors"),
        "rx_dropped": _read_int(f"{stats_base}/rx_dropped"),
        "tx_dropped": _read_int(f"{stats_base}/tx_dropped"),
    }


def _throughput_sample(iface):
    """RX/TX byte-rate over a fixed, bounded sampling window."""
    stats_base = f"/sys/class/net/{iface}/statistics"
    rx0 = _read_int(f"{stats_base}/rx_bytes")
    tx0 = _read_int(f"{stats_base}/tx_bytes")
    t0 = time.monotonic()
    time.sleep(THROUGHPUT_SAMPLE_SECONDS)
    rx1 = _read_int(f"{stats_base}/rx_bytes")
    tx1 = _read_int(f"{stats_base}/tx_bytes")
    elapsed = time.monotonic() - t0
    if None in (rx0, rx1, tx0, tx1) or elapsed <= 0:
        return {"rx_mbps": None, "tx_mbps": None, "sample_seconds": elapsed}
    return {
        "rx_mbps": round(((rx1 - rx0) * 8 / elapsed) / 1_000_000, 3),
        "tx_mbps": round(((tx1 - tx0) * 8 / elapsed) / 1_000_000, 3),
        "sample_seconds": round(elapsed, 2),
    }


def _ping(host):
    if not host:
        return {"host": None, "reachable": False}
    ok, out, err = _run("/bin/ping", "-c", PING_COUNT, "-W", PING_TIMEOUT, host,
                        timeout=int(PING_COUNT) * int(PING_TIMEOUT) + 5)
    result = {"host": host, "reachable": ok, "rtt_ms": None, "packet_loss_pct": None}
    m = re.search(r"(\d+(?:\.\d+)?)% packet loss", out)
    if m:
        result["packet_loss_pct"] = float(m.group(1))
    m = re.search(r"= [\d.]+/([\d.]+)/", out)
    if m:
        result["rtt_ms"] = float(m.group(1))
    if not ok and not out:
        result["error"] = err[:150]
    return result


def _dns_timing(host):
    if not host:
        return {"host": None, "resolved": False}
    t0 = time.monotonic()
    try:
        addr = socket.gethostbyname(host)
        elapsed_ms = round((time.monotonic() - t0) * 1000, 2)
        return {"host": host, "resolved": True, "address": addr,
                "resolve_ms": elapsed_ms}
    except OSError as e:
        return {"host": host, "resolved": False,
                "error": e.__class__.__name__,
                "resolve_ms": round((time.monotonic() - t0) * 1000, 2)}


def _route_table():
    ok, out, _ = _run("/sbin/ip", "-j", "route", "show")
    if not ok:
        ok, out, _ = _run("/usr/sbin/ip", "-j", "route", "show")
    try:
        routes = json.loads(out or "[]")
    except ValueError:
        return []
    # Only LAN-relevant fields; nothing exotic (no VPN internals etc.) leaks.
    return [{"dst": r.get("dst"), "dev": r.get("dev"), "gateway": r.get("gateway"),
            "prefsrc": r.get("prefsrc")} for r in routes][:30]


def _kernel_net_errors():
    ok, out, _ = _run("/bin/dmesg", timeout=10)
    if not ok:
        ok, out, _ = _run("/usr/bin/dmesg", timeout=10)
    if not ok:
        return {"available": False, "lines": []}
    keywords = ("link is down", "link is not ready", "nic link is up",
                "eth", "carrier", "timeout", "tx queue")
    lines = [redact(l.strip())[:200] for l in out.splitlines()
             if any(k in l.lower() for k in keywords)]
    return {"available": True, "lines": lines[-DMESG_LINE_CAP:]}


def _plex_docker_networks(rows):
    row = find_plex(rows)
    if row is None:
        return {}
    d = inspect(row["ID"])
    return d.get("networks", {})


def act_network_status():
    iface, gateway = _default_route()
    if not iface:
        fail(3, "could not discover the active default-route interface")
    addr = _iface_addr(iface)
    stats = _iface_stats(iface)
    throughput = _throughput_sample(iface)

    known_hosts = {"gateway": gateway, "dex247": os.getenv("LOKI_DEX247_LAN_IP") or None,
                   "razr": os.getenv("LOKI_RAZR_LAN_IP") or None}
    reachability = {name: _ping(host) for name, host in known_hosts.items()}
    dns = {"nas_hostname": _dns_timing(socket.gethostname()),
          "gateway": _dns_timing(gateway) if gateway else {"resolved": False}}

    rows = ps_all()
    saturation = None
    if stats.get("speed_mbps") and throughput.get("rx_mbps") is not None:
        capacity = stats["speed_mbps"]
        used_pct = max(throughput["rx_mbps"], throughput["tx_mbps"]) / capacity * 100
        saturation = round(used_pct, 1)

    return {
        "interface": iface,
        "address": addr,
        "gateway": gateway,
        "link": {"speed_mbps": stats.get("speed_mbps"),
                 "duplex": stats.get("duplex"),
                 "mtu": stats.get("mtu"),
                 "operstate": stats.get("operstate"),
                 "carrier": stats.get("carrier"),
                 "carrier_changes": stats.get("carrier_changes")},
        "counters": {"rx_bytes": stats.get("rx_bytes"), "tx_bytes": stats.get("tx_bytes"),
                    "rx_errors": stats.get("rx_errors"), "tx_errors": stats.get("tx_errors"),
                    "rx_dropped": stats.get("rx_dropped"), "tx_dropped": stats.get("tx_dropped")},
        "current_throughput": throughput,
        "saturation_pct_of_link": saturation,
        "reachability": reachability,
        "dns": dns,
        "routes": _route_table(),
        "kernel_network_errors": _kernel_net_errors(),
        "plex_docker_networks": _plex_docker_networks(rows),
    }


def act_network_tooling_check():
    present = os.path.isfile(IPERF3) and os.access(IPERF3, os.X_OK)
    version = ""
    if present:
        ok, out, _ = _run(IPERF3, "--version", timeout=10)
        version = out.splitlines()[0][:80] if ok and out else ""
    return {"iperf3_installed": present, "iperf3_path": IPERF3 if present else None,
            "iperf3_version": version}


def act_network_speed_test():
    if not (os.path.isfile(IPERF3) and os.access(IPERF3, os.X_OK)):
        fail(3, f"{IPERF3} is not installed — run network_tooling_check first")
    iface, _gw = _default_route()
    if not iface:
        fail(3, "could not discover the active default-route interface")
    addr = _iface_addr(iface)
    if not addr:
        fail(3, f"interface {iface} has no IPv4 address to bind the test to")
    try:
        ipaddress.ip_address(addr)
    except ValueError:
        fail(3, "discovered bind address failed validation")
    # -1: exit after ONE client test. timeout: hard backstop if none connects.
    # Bound to the discovered LAN address only — never 0.0.0.0.
    ok, out, err = _run("/usr/bin/timeout", str(IPERF3_SERVER_TIMEOUT), IPERF3,
                        "-s", "-1", "-B", addr, "-p", str(IPERF3_PORT), "-J",
                        timeout=IPERF3_SERVER_TIMEOUT + 5)
    return {"bind_address": addr, "port": IPERF3_PORT, "server_ran": ok,
            "server_output_json": out[:4000] if ok else "",
            "server_stderr": err if not ok else ""}


# ── disk diagnostics (Pass 3) ────────────────────────────────────────────
def act_disk_status():
    ok, out, _ = _run("/bin/df", "-hT")
    if not ok:
        ok, out, _ = _run("/usr/bin/df", "-hT")
    disks = []
    for line in (out or "").splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 7 and any(parts[-1].startswith(p) for p in SAFE_MOUNT_PREFIXES):
            disks.append({"fs": parts[0][:60], "type": parts[1], "size": parts[2],
                         "used": parts[3], "avail": parts[4], "use_pct": parts[5],
                         "mount": parts[-1]})

    diskstats = []
    for line in (_read_str("/proc/diskstats") or "").splitlines():
        parts = line.split()
        if len(parts) < 14:
            continue
        name = parts[2]
        if re.match(r"^(loop|ram|dm-)", name):
            continue
        diskstats.append({"device": name, "reads_completed": int(parts[3]),
                          "writes_completed": int(parts[7]),
                          "io_in_progress": int(parts[11]),
                          "io_ms_weighted": int(parts[13])})

    mdstat = _read_str("/proc/mdstat")
    smart = []
    for d in diskstats:
        dev = f"/dev/{d['device']}"
        ok, out, _ = _run("/usr/sbin/smartctl", "-H", dev, timeout=10)
        if not ok and "smartctl" not in (out or ""):
            smart.append({"device": dev, "available": False})
            continue
        health = "PASSED" in out or "OK" in out
        smart.append({"device": dev, "available": True, "healthy": health})

    kernel_errors = []
    ok, out, _ = _run("/bin/dmesg", timeout=10)
    if ok:
        kernel_errors = [redact(l.strip())[:200] for l in out.splitlines()
                         if re.search(r"(?i)i/o error|ata\d+.*error|end_request",
                                     l)][-DMESG_LINE_CAP:]

    return {"filesystems": disks, "device_io": diskstats,
            "mdraid": mdstat, "smart": smart,
            "kernel_disk_errors": kernel_errors}


