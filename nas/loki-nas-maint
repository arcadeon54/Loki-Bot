}

# Actions that change state. Each is approval-gated on Loki's side; the
# dispatcher additionally refuses to apply without verified backups and a
# matching prepare_id, so an approval cannot be replayed against a new plan.
WRITE_ACTIONS = {
    "tracearr_update_prepare": (act_tracearr_update_prepare, "digest"),
    "tracearr_backup": (act_tracearr_backup, None),
    "tracearr_apply_update": (act_tracearr_apply_update, "prepare_id"),
    "tracearr_verify_update": (act_tracearr_verify_update, None),
    "tracearr_rollback": (act_tracearr_rollback, None),
    "plex_restart": (act_plex_restart, None),
}


def main():
    argv = sys.argv[1:]
    known = sorted(list(ACTIONS) + list(WRITE_ACTIONS))
    if not argv:
        fail(2, f"an action is required; known: {known}")
    action = argv[0]
    # Strict token: no paths, flags, separators or shell metacharacters survive.
    if not re.fullmatch(r"[a-z][a-z0-9_]{2,39}", action):
        fail(2, f"unknown action; known: {known}")

    if action in ACTIONS:
        if len(argv) != 1:
            fail(2, f"action {action!r} takes no arguments")
        payload = ACTIONS[action]()
    elif action in WRITE_ACTIONS:
        fn, kind = WRITE_ACTIONS[action]
        if kind is None:
            if len(argv) != 1:
                fail(2, f"action {action!r} takes no arguments")
            payload = fn()
        else:
            if len(argv) != 2:
                fail(2, f"action {action!r} takes exactly one {kind}")
            value = argv[1]
            # The ONLY caller-supplied values in the whole dispatcher, each
            # pinned to a strict shape. A digest is meaningful only against
            # TRACEARR_REPO, which is hardcoded — no repository, tag, path or
            # container name can be supplied.
            pattern = DIGEST_RE if kind == "digest" else PREPARE_ID_RE
            if not pattern.match(value):
                fail(2, f"malformed {kind}")
            payload = fn(value)
    else:
        fail(2, f"unknown action; known: {known}")
    print(json.dumps({"ok": True, "action": action, "data": payload},
                     default=str))


if __name__ == "__main__":
    main()
