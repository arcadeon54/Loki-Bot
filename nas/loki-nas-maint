def act_plex_dependencies():
    rows = ps_all()
    row = plex_or_die(rows)
    raw = docker("inspect", row["ID"])
    try:
        data = json.loads(raw)[0]
    except (ValueError, IndexError):
        fail(4, "could not parse docker inspect output")
    mounts = []
    for m in data.get("Mounts") or []:
        dest = m.get("Destination") or ""
        entry = {"destination": dest, "type": m.get("Type"), "rw": m.get("RW")}
        if any(dest.startswith(p) for p in SAFE_MOUNT_PREFIXES) or dest.startswith("/data") \
                or dest.startswith("/config") or dest.startswith("/media"):
            ok, out, _ = _run("/bin/df", "-h", dest, timeout=10)
            if ok:
                parts = out.splitlines()[-1].split() if len(out.splitlines()) > 1 else []
                entry["present"] = True
                entry["avail"] = parts[3] if len(parts) >= 4 else None
                entry["use_pct"] = parts[4] if len(parts) >= 5 else None
            else:
                entry["present"] = False
        mounts.append(entry)
    app = inspect(row["ID"])
    return {"plex": {"name": app["name"], "state": app["state"]},
            "mounts": mounts, "networks": app.get("networks", {})}


