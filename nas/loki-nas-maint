def act_plex_transcode_processes():
    rows = ps_all()
    row = plex_or_die(rows)
    raw = docker("top", row["ID"])
    lines = raw.splitlines()
    if not lines:
        return {"container": row.get("Names"), "processes": []}
    header = lines[0].split()
    cmd_idx = header.index("CMD") if "CMD" in header else len(header) - 1
    procs = []
    for line in lines[1:]:
        parts = line.split(None, len(header) - 1)
        if len(parts) <= cmd_idx:
            continue
        cmd = parts[cmd_idx]
        if "transcode" in cmd.lower() or "ffmpeg" in cmd.lower() or "plex tv" in cmd.lower():
            procs.append({"cmd": redact(cmd)[:200],
                          "cpu": parts[header.index("%CPU")] if "%CPU" in header else None})
    return {"container": row.get("Names"), "transcode_processes": procs,
            "transcoding": bool(procs)}


def act_plex_restart():
    """Start Plex ONLY if it is currently stopped and its declared media
    mounts are present. Never restart/stop/kill a running container."""
    rows = ps_all()
    row = plex_or_die(rows)
    app = inspect(row["ID"])
    if app["running"]:
        fail(3, "Plex is already running — refusing to touch a running container")
    if app["state"] not in ("exited", "created", "dead"):
        fail(3, f"Plex is in state {app['state']!r}, not a stopped state — refusing")
    deps = act_plex_dependencies()
    missing = [m["destination"] for m in deps["mounts"] if m.get("present") is False]
    if missing:
        fail(3, f"refusing to start Plex: mounts missing: {', '.join(missing)}")
    docker("start", row["ID"])
    after = inspect(row["ID"])
    return {"started": True, "container": after["name"], "state": after["state"],
            "running": after["running"]}


