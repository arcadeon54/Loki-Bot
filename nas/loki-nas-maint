def find_plex(rows):
    """Identify Plex without trusting any caller input, same shape as
    find_tracearr: label/image/name match first, published port as fallback."""
    for row in rows:
        labels = parse_labels(row.get("Labels"))
        hay = " ".join([
            labels.get("com.docker.compose.service", ""),
            labels.get("com.docker.compose.project", ""),
            labels.get("org.opencontainers.image.title", ""),
            row.get("Image", ""), row.get("Names", ""),
        ]).lower()
        if "plex" in hay:
            return row
    for row in rows:
        if f":{PLEX_PORT}->" in (row.get("Ports") or ""):
            return row
    return None


def plex_or_die(rows):
    row = find_plex(rows)
    if row is None:
        fail(3, "Plex container not found by label, image, port or name")
    return row


