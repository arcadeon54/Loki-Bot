def act_tracearr_restart_forensics():
    """Read-only evidence for WHY the app container keeps restarting.

    Distinguishes an application exit (docker records die→start and bumps
    RestartCount) from an external `docker restart`, a healthcheck action, or
    an internal maintenance cycle that never exits the process."""
    rows = ps_all()
    project, found = stack(rows)
    app = found["tracearr"]
    raw = docker("inspect", app["ID"])
    try:
        data = json.loads(raw)[0]
    except (ValueError, IndexError):
        fail(4, "could not parse docker inspect output")
    state = data.get("State") or {}
    health = state.get("Health") or {}
    cfg = data.get("Config") or {}
    hc = cfg.get("Healthcheck") or {}
    # Healthcheck probe history: exit codes and bounded, redacted output.
    log = []
    for entry in (health.get("Log") or [])[-6:]:
        log.append({"start": entry.get("Start"), "end": entry.get("End"),
                    "exit_code": entry.get("ExitCode"),
                    "output": redact((entry.get("Output") or "").strip())[:300]})
    # Container-scoped docker events over a bounded window. Read-only: this
    # only reads the daemon's event journal, it never acts on the container.
    #
    # KNOWN LIMITATION — read before trusting an empty `events` list.
    # `docker events --since` is served from an IN-MEMORY ring buffer (~256
    # entries), not a persisted log. Every healthchecked container emits three
    # exec_* events per probe, so on a host with several 10-30s healthchecks
    # the buffer turns over in MINUTES. Asking for 48h returns only the last
    # few minutes, and lifecycle events (die/start/restart) age out long before
    # a caller sees them. Measured 2026-07-27 on dex247: 254 events for a
    # requested 48h window, 100% of them exec_*, zero lifecycle events across
    # 33 containers.
    #
    # Therefore an empty `events` list is NOT evidence that no restart
    # happened. Use events_raw_count / events_raw_first_ts below to see how far
    # back the buffer actually reached, and treat State.FinishedAt +
    # RestartCount as the authoritative restart evidence instead.
    events = []
    ev_error = None
    # Instrumentation: an empty `events` list is ambiguous on its own — it can
    # mean the daemon's event ring buffer is too shallow to reach a restart, or
    # that the container filter matched nothing at all. These counters tell the
    # two apart without another round trip.
    raw_count = 0
    exec_excluded = 0
    raw_first = raw_last = None
    try:
        # Scope by container ID, not name: a name filter PREFIX-matches, so
        # "tracearr" would also sweep in tracearr-db and tracearr-redis.
        raw_ev = docker("events", "--since", "48h", "--until", "0s",
                        "--filter", f"container={data.get('Id') or ''}",
                        "--filter", "type=container",
                        "--format", "{{json .}}", timeout=40)
        for line in raw_ev.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            raw_count += 1
            ts = e.get("time")
            if ts is not None:
                raw_first = ts if raw_first is None else min(raw_first, ts)
                raw_last = ts if raw_last is None else max(raw_last, ts)
            action = e.get("Action") or ""
            # Healthcheck probes fire every 30s and would otherwise crowd the
            # lifecycle events we actually need out of the window.
            if action.startswith("exec_"):
                exec_excluded += 1
                continue
            attrs = (e.get("Actor") or {}).get("Attributes") or {}
            events.append({
                "action": action,
                "time": e.get("time"),
                "time_nano": e.get("timeNano"),
                "exit_code": attrs.get("exitCode"),
                "signal": attrs.get("signal"),
            })
    except SystemExit:
        raise
    except Exception as e:                      # events unsupported / no journal
        ev_error = e.__class__.__name__
    return {
        "compose_project": project,
        "container": app.get("Names"),
        "container_id": (data.get("Id") or "")[:12],
        "container_created": data.get("Created"),
        "state": {
            "status": state.get("Status"),
            "running": state.get("Running"),
            "restarting": state.get("Restarting"),
            "started_at": state.get("StartedAt"),
            "finished_at": state.get("FinishedAt"),
            "exit_code": state.get("ExitCode"),
            "error": redact(state.get("Error") or ""),
            "oom_killed": state.get("OOMKilled"),
            "pid": state.get("Pid"),
        },
        "restart_count": data.get("RestartCount"),
        "restart_policy": ((data.get("HostConfig") or {}).get("RestartPolicy")
                           or {}).get("Name"),
        "healthcheck": {
            # The probe command is config, not a secret, but redact anyway in
            # case a URL with credentials was baked into it.
            "test": [redact(str(t)) for t in (hc.get("Test") or [])],
            "interval_ns": hc.get("Interval"),
            "timeout_ns": hc.get("Timeout"),
            "retries": hc.get("Retries"),
            "start_period_ns": hc.get("StartPeriod"),
            "status": health.get("Status"),
            "failing_streak": health.get("FailingStreak"),
            "log": log,
        },
        "events": events[-60:],
        "events_window": "48h, lifecycle only (exec_* healthcheck probes excluded)",
        "events_raw_count": raw_count,
        "events_exec_excluded": exec_excluded,
        "events_raw_first_ts": raw_first,
        "events_raw_last_ts": raw_last,
        "events_error": ev_error,
        "note": ("RestartCount increments only for restart-policy restarts "
                 "after the process exits; a manual `docker restart` does not "
                 "increment it. An EMPTY events list proves nothing: the "
                 "daemon's event ring buffer (~256 entries) is exhausted by "
                 "healthcheck exec_* probes within minutes, so lifecycle "
                 "events age out. Compare events_raw_first_ts against the "
                 "requested window before drawing any conclusion."),
    }


def _strip_sql_params(message):
    """Split a Drizzle 'Failed query' message into SQL, params and cause.

    Returns (sql_redacted, postgres_reason). The bound parameter VALUES are
    dropped entirely and never returned — only their count — because a failing
    query can just as easily be carrying a token or a password as a setting
    name."""
    if not isinstance(message, str):
        return "", ""
    sql, reason = "", ""
    body = message
    if "Failed query:" in body:
        body = body.split("Failed query:", 1)[1]
    if "params:" in body:
        sql, rest = body.split("params:", 1)
        # Everything after the parameter list, past the final ": ", is the
        # driver's cause string (e.g. "Connection terminated due to ...").
        params, _, tail = rest.partition(": ")
        n = len([p for p in params.split(",") if p.strip()])
        sql = f"{sql.strip()}  [params: {n} value(s) REDACTED]"
        reason = tail.strip()
    else:
        sql = body.strip()
    return redact(sql)[:SQL_CONTEXT_CAP], redact(reason)[:ERROR_REASON_CAP]


def _extract_errors(raw_lines, boundary=None, parse=None):
    """Structured error objects from error-level JSON log lines.

    Only these lines get the larger character budget; ordinary request-log
    lines stay at the normal cap so total output remains bounded.

    Selection is anchored on the EXIT, not on the start of the tail: the tail
    spans many hours, and the errors that explain a specific exit are the ones
    immediately before it. Taking the first N found returns the oldest errors
    in the tail, which is almost never what a caller wants.
    """
    found = []
    for line in raw_lines:
        if '"level":50' not in line and '"err"' not in line:
            continue
        payload = line.split(" ", 1)[-1]
        brace = payload.find("{")
        if brace < 0:
            continue
        try:
            rec = json.loads(payload[brace:])
        except ValueError:
            continue
        err = rec.get("err") or {}
        if not err:
            continue
        message = err.get("message") or ""
        sql, reason = _strip_sql_params(message)
        found.append({
            "timestamp": line.split(" ", 1)[0],
            "error_type": redact(str(err.get("type") or ""))[:120],
            "error_message": redact(message)[:ERROR_LINE_CHAR_CAP],
            "postgres_reason": reason,
            "query_context_redacted": sql,
            "line_truncated": len(message) > ERROR_LINE_CHAR_CAP,
        })
    if boundary is None or parse is None:
        return found[-MAX_ERROR_OBJECTS:]
    # Anchor on the exit: the last errors before it, plus a couple after the
    # restart to show whether the same fault recurs immediately.
    before, after = [], []
    for e in found:
        try:
            when = parse(e["timestamp"])
        except (ValueError, IndexError):
            continue
        (before if when <= boundary else after).append(e)
    picked = before[-(MAX_ERROR_OBJECTS - 2):] + after[:2]
    return picked or found[-MAX_ERROR_OBJECTS:]


def act_tracearr_exit_window_logs():
    """Persisted logs bracketing the LAST container exit.

    docker logs is written to disk by the json-file driver and survives
    restarts, so unlike the event ring buffer it can still answer what the
    application was doing when it exited. The window is derived internally
    from State.FinishedAt/StartedAt — a caller supplies nothing.
    """
    rows = ps_all()
    _project, found = stack(rows)
    app = found["tracearr"]
    raw = docker("inspect", app["ID"])
    try:
        data = json.loads(raw)[0]
    except (ValueError, IndexError):
        fail(4, "could not parse docker inspect output")
    state = data.get("State") or {}
    fin, sta = state.get("FinishedAt"), state.get("StartedAt")
    if not fin or fin.startswith("0001-01-01"):
        fail(3, "container has no recorded FinishedAt — it has never exited")

    def _parse(ts):
        # RFC3339 with variable fractional digits; trim to microseconds.
        t = (ts or "").replace("Z", "+00:00")
        if "." in t:
            head, rest = t.split(".", 1)
            frac = "".join(c for c in rest if c.isdigit())[:6]
            tz = rest[len(frac):] if not rest[len(frac):].isdigit() else "+00:00"
            t = f"{head}.{frac.ljust(6, '0')}{tz or '+00:00'}"
        return datetime.datetime.fromisoformat(t)

    try:
        f_dt = _parse(fin)
        s_dt = _parse(sta) if sta else f_dt
    except ValueError:
        fail(3, "could not parse container timestamps")

    since = (f_dt - datetime.timedelta(seconds=PRE_EXIT_SECONDS))
    until = (s_dt + datetime.timedelta(seconds=POST_START_SECONDS))
    fmt = "%Y-%m-%dT%H:%M:%SZ"

    # This container's json-file log has a CORRUPTED region: a --since/--until
    # query makes the daemon scan forward from an offset and it dies with
    #   Error grabbing logs: invalid character '\x00' looking for beginning of value
    # Reading BACKWARD with --tail avoids that region entirely, so take a tail
    # and filter to the window here. Walk a descending ladder so a corruption
    # that sits inside a deep tail degrades to a shallower one instead of
    # failing outright.
    out, used_tail, corruption, last_err = "", None, False, ""
    for cap in TAIL_LADDER:
        ok, text, err = docker_try("logs", "--timestamps", "--tail", str(cap),
                                   app["ID"], timeout=60)
        if ok:
            out, used_tail = text, cap
            break
        last_err = err
        if "\\x00" in err or "invalid character" in err:
            corruption = True
        continue
    if used_tail is None:
        fail(4, f"could not read logs at any tail depth {list(TAIL_LADDER)}: "
                f"{last_err}")

    raw_lines = [redact(l.rstrip()) for l in out.splitlines() if l.strip()]
    pre, post = [], []
    for line in out.splitlines():
        line = redact(line.rstrip())[:LINE_CHAR_CAP]
        if not line:
            continue
        stamp = line.split(" ", 1)[0]
        try:
            when = _parse(stamp)
        except (ValueError, IndexError):
            # Unstamped continuation line: attribute it to the side we are on.
            (post if post else pre).append(line)
            continue
        (pre if when <= f_dt else post).append(line)
    # Only keep pre-exit lines inside the window, and record whether the tail
    # reached far enough back to cover it.
    window_reached = False
    if pre:
        try:
            oldest = _parse(pre[0].split(" ", 1)[0])
            window_reached = oldest <= since
        except (ValueError, IndexError):
            window_reached = False
    truncated = len(pre) > PRE_LINE_CAP or len(post) > POST_LINE_CAP
    return {
        "container": app.get("Names"),
        "window_since": since.astimezone(datetime.timezone.utc).strftime(fmt),
        "window_until": until.astimezone(datetime.timezone.utc).strftime(fmt),
        "finished_at": fin,
        "started_at": sta,
        "restart_count": data.get("RestartCount"),
        # Lines closest to the exit are the interesting ones, so keep the TAIL
        # of the pre-exit side and the HEAD of the post-start side.
        "pre_exit_lines": pre[-PRE_LINE_CAP:],
        "post_start_lines": post[:POST_LINE_CAP],
        "pre_exit_total": len(pre),
        "post_start_total": len(post),
        "truncated": truncated,
        "tail_depth_used": used_tail,
        # True when a deeper read was rejected by the NUL-corrupted region.
        "log_corruption_detected": corruption,
        # Structured errors get a larger per-line budget than ordinary lines;
        # SQL parameter VALUES are never included.
        "errors": _extract_errors(raw_lines, f_dt, _parse),
        "errors_anchored_on": "exit boundary (finished_at)",
        # Did the tail actually reach back past the start of the window? If
        # false, the pre-exit context is incomplete and must not be read as
        # "nothing happened before the exit".
        "window_reached": window_reached,
        "note": ("persisted json-file logs read BACKWARD via --tail, because a "
                 "--since/--until scan hits a corrupted (NUL) region in this "
                 "container's json-file log. Window derived internally from "
                 "State.FinishedAt/StartedAt."),
    }


# ── update workflow helpers ────────────────────────────────────────────────
def _state_read():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def _state_write(state):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def _free_mb(path):
    try:
        st = os.statvfs(path)
        return int(st.f_bavail * st.f_frsize / 1048576)
    except OSError:
        return -1


def _sha256_file(path):
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
    except OSError:
        return ""
    return h.hexdigest()


def _tracearr_ctx():
    """Discover the stack and its compose file. No caller input."""
    rows = ps_all()
    project, found = stack(rows)
    app = found["tracearr"]
    raw = docker("inspect", app["ID"])
    try:
        data = json.loads(raw)[0]
    except (ValueError, IndexError):
        fail(4, "could not parse docker inspect output")
    cfg = data.get("Config") or {}
    labels = cfg.get("Labels") or {}
    compose_file = labels.get("com.docker.compose.project.config_files") or ""
    if not compose_file or not os.path.isfile(compose_file):
        fail(3, "compose file for the tracearr project was not found on disk")
    return {
        "project": project, "found": found, "app_id": app["ID"],
        "app_name": app.get("Names"), "compose_file": compose_file,
        "compose_service": labels.get("com.docker.compose.service") or "tracearr",
        "current_image": cfg.get("Image") or "",
        "db_id": (found.get("postgres") or {}).get("ID"),
        "db_name": (found.get("postgres") or {}).get("Names"),
        "redis_name": (found.get("redis") or {}).get("Names"),
    }


def _db_credentials(db_id):
    """POSTGRES_USER / POSTGRES_DB read from the db container. Used ONLY to
    build the pg_dump argv — never returned, never logged."""
    raw = docker("inspect", db_id)
    try:
        env = (json.loads(raw)[0].get("Config") or {}).get("Env") or []
    except (ValueError, IndexError):
        return "", ""
    vals = {}
    for e in env:
        if "=" in e:
            k, v = e.split("=", 1)
            if k in ("POSTGRES_USER", "POSTGRES_DB"):
                vals[k] = v
    return vals.get("POSTGRES_USER", ""), vals.get("POSTGRES_DB", "")


def _compose_argv(ctx, *rest):
    return ["compose", "-f", ctx["compose_file"], *rest]


def act_tracearr_update_prepare(digest):
    """Record an approved-update plan. Changes nothing on the system."""
    ctx = _tracearr_ctx()
    ok, _out, err = docker_try("compose", "version", timeout=20)
    if not ok:
        fail(4, f"docker compose plugin unavailable: {err[:120]}")
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d-%H%M%S")
    backup_dir = f"{BACKUP_ROOT}/{stamp}"
    prepare_id = hashlib.sha256(
        f"{ctx['current_image']}|{digest}|{stamp}".encode()).hexdigest()[:16]
    free_mb = _free_mb(os.path.dirname(BACKUP_ROOT) if
                       os.path.isdir(os.path.dirname(BACKUP_ROOT)) else "/")
    state = {
        "prepare_id": prepare_id,
        "created_at": stamp,
        "repo": TRACEARR_REPO,
        "current_image": ctx["current_image"],
        "target_image": f"{TRACEARR_REPO}@{digest}",
        "target_digest": digest,
        "compose_file": ctx["compose_file"],
        "compose_service": ctx["compose_service"],
        "backup_dir": backup_dir,
        "app_container": ctx["app_name"],
        "db_container": ctx["db_name"],
        "redis_container": ctx["redis_name"],
        "backup": None, "applied": None, "verified": None, "rolled_back": None,
        "free_mb_at_prepare": free_mb,
    }
    _state_write(state)
    return {"prepare_id": prepare_id, "current_image": ctx["current_image"],
            "target_image": state["target_image"], "backup_dir": backup_dir,
            "compose_file": ctx["compose_file"],
            "compose_service": ctx["compose_service"],
            "free_mb": free_mb, "free_mb_required": MIN_FREE_MB,
            "sufficient_space": free_mb < 0 or free_mb >= MIN_FREE_MB,
            "note": "plan recorded; nothing changed. Backup runs next."}


def act_tracearr_backup():
    """Copy the compose file and dump the database, then verify both."""
    state = _state_read()
    if not state.get("prepare_id"):
        fail(3, "no prepared update plan — run tracearr_update_prepare first")
    ctx = _tracearr_ctx()
    backup_dir = state["backup_dir"]
    free_mb = _free_mb(BACKUP_ROOT if os.path.isdir(BACKUP_ROOT) else "/")
    if 0 <= free_mb < MIN_FREE_MB:
        fail(3, f"refusing to back up: only {free_mb}MB free, need {MIN_FREE_MB}MB")
    os.makedirs(backup_dir, mode=0o700, exist_ok=True)

    compose_copy = os.path.join(backup_dir, "docker-compose.yml")
    try:
        shutil.copy2(state["compose_file"], compose_copy)
    except OSError as e:
        fail(3, f"compose backup failed: {e.__class__.__name__}")
    compose_ok = os.path.isfile(compose_copy) and os.path.getsize(compose_copy) > 0

    dump_path = os.path.join(backup_dir, "tracearr-db.sql.gz")
    user, dbname = _db_credentials(ctx["db_id"])
    if not user or not dbname:
        fail(3, "could not determine database user/name from the db container")
    try:
        with open(dump_path, "wb") as out_f:
            pg = subprocess.Popen(
                [DOCKER, "exec", ctx["db_id"], "pg_dump", "-U", user, "-d", dbname],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            gz = subprocess.Popen(["gzip", "-c"], stdin=pg.stdout, stdout=out_f,
                                  stderr=subprocess.PIPE)
            pg.stdout.close()
            _, gz_err = gz.communicate(timeout=900)
            pg.wait(timeout=30)
            _, pg_err = pg.communicate()
    except (OSError, subprocess.TimeoutExpired) as e:
        fail(4, f"database dump failed: {e.__class__.__name__}")
    dump_rc_ok = pg.returncode == 0 and gz.returncode == 0
    size = os.path.getsize(dump_path) if os.path.isfile(dump_path) else 0
    integrity = subprocess.run(["gzip", "-t", dump_path], capture_output=True)
    dump_ok = dump_rc_ok and size > 0 and integrity.returncode == 0

    info = {"backup_dir": backup_dir,
            "compose_backup": compose_copy, "compose_ok": compose_ok,
            "compose_sha256": _sha256_file(compose_copy)[:32],
            "database_dump": dump_path, "database_ok": dump_ok,
            "database_size_bytes": size,
            "database_sha256": _sha256_file(dump_path)[:32],
            "gzip_integrity_ok": integrity.returncode == 0,
            "free_mb_after": _free_mb(BACKUP_ROOT)}
    if not dump_ok:
        info["stderr"] = redact((pg_err or b"").decode("utf-8", "replace"))[:200]
    state["backup"] = info
    _state_write(state)
    info["verified"] = bool(compose_ok and dump_ok)
    return info


def act_tracearr_apply_update(prepare_id):
    """Pull the approved digest and recreate ONLY the tracearr service."""
    state = _state_read()
    if not state.get("prepare_id"):
        fail(3, "no prepared update plan")
    if state["prepare_id"] != prepare_id:
        fail(3, "prepare_id does not match the recorded plan — re-prepare and "
                "get fresh approval")
    backup = state.get("backup") or {}
    if not (backup.get("compose_ok") and backup.get("database_ok")):
        fail(3, "refusing to update: verified backups are not present")
    ctx = _tracearr_ctx()
    if ctx["current_image"] != state["current_image"]:
        fail(3, "the running image changed since the plan was prepared — "
                "re-prepare and get fresh approval")

    target = state["target_image"]
    ok, _o, err = docker_try("pull", target, timeout=900)
    if not ok:
        fail(4, f"pull of the approved digest failed: {err[:180]}")

    # Point the compose service at the approved digest by replacing the exact
    # current image reference. A literal replacement of a known string — no
    # templating, no YAML rewriting, nothing else in the file is touched.
    try:
        with open(state["compose_file"]) as f:
            original = f.read()
    except OSError as e:
        fail(3, f"could not read compose file: {e.__class__.__name__}")
    if state["current_image"] not in original:
        fail(3, "current image reference not found verbatim in the compose "
                "file — refusing to edit it blindly")
    updated = original.replace(state["current_image"], target)
    try:
        with open(state["compose_file"], "w") as f:
            f.write(updated)
    except OSError as e:
        fail(3, f"could not write compose file: {e.__class__.__name__}")

    ok, out, err = docker_try(*_compose_argv(
        ctx, "up", "-d", "--no-deps", state["compose_service"]), timeout=600)
    applied = {"pulled": target, "compose_updated": True,
               "recreate_ok": ok, "stderr": redact(err)[:300] if not ok else ""}
    state["applied"] = applied
    _state_write(state)
    if not ok:
        fail(4, f"recreate failed: {err[:180]}")
    return applied


def _http_check(url, timeout=15):
    p = subprocess.run(["curl", "-sS", "-m", str(timeout), "-o", "-",
                        "-w", "\\n%{http_code}", url],
                       capture_output=True, text=True)
    body, _, code = (p.stdout or "").rpartition("\n")
    return {"url": url, "http_code": code.strip() or "000",
            "ok": code.strip() == "200",
            "body": redact(body.strip())[:300]}


def _verify_once():
    """One full verification sweep. Returns (checks, failures)."""
    rows = ps_all()
    _project, found = stack(rows)
    checks, failures = {}, []
    for role in ("tracearr", "redis", "postgres"):
        row = found.get(role)
        if not row:
            checks[role] = {"present": False}
            failures.append(f"{role} missing")
            continue
        d = inspect(row["ID"])
        healthy = d["running"] and d["health"] in (None, "healthy")
        checks[role] = {"present": True, "container": d["name"],
                        "state": d["state"], "health": d["health"],
                        "restart_count": d["restart_count"], "ok": healthy}
        if not healthy:
            failures.append(f"{role} {d['state']}/{d['health']}")
    local = _http_check(LOCAL_HEALTH_URL)
    checks["local_http"] = local
    if not local["ok"]:
        failures.append(f"local HTTP {local['http_code']}")
    else:
        for field in ("db", "redis"):
            if f'"{field}":true' not in local["body"].replace(" ", ""):
                failures.append(f"health endpoint reports {field} not ok")
    public = _http_check(PUBLIC_HEALTH_URL)
    checks["public_http"] = public
    # Public URL is supplementary evidence: proxy/DNS faults are not the app's.
    return checks, failures


def act_tracearr_verify_update():
    """Verify the stack, waiting a bounded time for the app to become ready.

    `compose up -d` returns when the container is CREATED, not when the app is
    listening. Tracearr needs tens of seconds to bind its port, so a single
    immediate sweep reports `health: starting` and `local HTTP 000` and calls a
    perfectly good deploy a failure. Poll until the sweep comes back clean or
    the deadline expires; only then is a failure real.
    """
    started = time.time()
    attempts = 0
    while True:
        attempts += 1
        checks, failures = _verify_once()
        waited = int(time.time() - started)
        if not failures or waited >= READINESS_DEADLINE_SECONDS:
            break
        time.sleep(READINESS_POLL_SECONDS)

    result = {"checks": checks, "failures": failures, "verified": not failures,
              "public_http_supplementary": True,
              "readiness": {"attempts": attempts, "waited_seconds": waited,
                            "deadline_seconds": READINESS_DEADLINE_SECONDS,
                            "timed_out": bool(failures)}}
    state = _state_read()
    if state.get("prepare_id"):
        state["verified"] = result
        _state_write(state)
    return result


def act_tracearr_rollback():
    """Restore the previous image and compose file, then re-verify."""
    state = _state_read()
    if not state.get("prepare_id"):
        fail(3, "no prepared update plan to roll back")
    if not (state.get("applied") or {}).get("recreate_ok"):
        fail(3, "nothing was applied — there is nothing to roll back")
    backup = state.get("backup") or {}
    compose_backup = backup.get("compose_backup") or ""
    if not os.path.isfile(compose_backup):
        fail(3, "compose backup is missing — refusing to roll back blindly")
    ctx = _tracearr_ctx()
    try:
        shutil.copy2(compose_backup, state["compose_file"])
    except OSError as e:
        fail(3, f"restoring compose failed: {e.__class__.__name__}")
    ok, _o, err = docker_try("pull", state["current_image"], timeout=900)
    pulled_back = ok
    ok2, _o2, err2 = docker_try(*_compose_argv(
        ctx, "up", "-d", "--no-deps", state["compose_service"]), timeout=600)
    verify = act_tracearr_verify_update()
    info = {"compose_restored": True, "previous_image": state["current_image"],
            "pull_ok": pulled_back, "recreate_ok": ok2,
            "verify_after_rollback": verify,
            "stderr": redact(err2)[:300] if not ok2 else "",
            "database_dump_preserved": backup.get("database_dump"),
            "note": ("The database dump is NOT restored automatically. If the "
                     "update ran a schema migration, rolling the image back "
                     "may not be sufficient — restore the dump deliberately.")}
    state["rolled_back"] = info
    _state_write(state)
    return info


def _stats(ids):
    """docker stats --no-stream over discovered ids only."""
    out = docker("stats", "--no-stream", "--format", "{{json .}}", *ids)
    rows = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            s = json.loads(line)
        except ValueError:
            continue
        rows.append({"name": s.get("Name"), "cpu_pct": s.get("CPUPerc"),
                     "mem_usage": s.get("MemUsage"), "mem_pct": s.get("MemPerc"),
                     "pids": s.get("PIDs")})
    return rows


