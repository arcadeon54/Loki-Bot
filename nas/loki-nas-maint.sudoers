# Loki NAS maintenance — the ONLY privileged capability granted to unimatrix_001.
#
# Each of the six actions is enumerated explicitly rather than using a trailing
# wildcard. The dispatcher validates its own argv, but enumerating here means a
# bug in that validation still cannot yield arbitrary arguments: sudo itself
# refuses anything not literally listed below.
#
# There is deliberately no entry permitting docker, a shell, or any path other
# than the dispatcher.

unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint host_status
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint container_inventory
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_status
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_dependencies
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_recent_logs
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_update_check
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_restart_forensics
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_exit_window_logs

# Pass 3: network / disk / Plex read-only diagnostics, plus one ephemeral
# throughput test. Same rule: enumerated literally, no wildcard, no shell.
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint network_status
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint network_tooling_check
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint network_speed_test
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint disk_status
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint plex_status
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint plex_dependencies
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint plex_recent_logs
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint plex_transcode_processes

# Approval-gated STATE-CHANGING actions. Still no shell and no free-form
# argument: the two that take a value are constrained to a literal action name
# plus a single token, and the dispatcher regex-validates it (sha256 digest or
# 16-hex prepare id) before doing anything.
#
# The digest entry deliberately does NOT try to match the "sha256:" prefix here.
# A ':' inside a sudoers command argument must be backslash-escaped, and older
# sudo builds disagree about that escape; the wildcard avoids the portability
# hazard entirely. Containment is unchanged: one literal action name plus one
# token, regex-validated by the dispatcher before anything runs.
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_update_prepare *
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_backup
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_apply_update *
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_verify_update
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint tracearr_rollback

# Plex auto-repair: ONE narrowly-scoped verb (docker start on an already-
# stopped container). Never restart/stop/kill — those verbs do not exist
# anywhere in this dispatcher.
unimatrix_001 ALL=(root) NOPASSWD: /usr/local/sbin/loki-nas-maint plex_restart
