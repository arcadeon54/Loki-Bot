{
  "loki-permission-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/permission-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
