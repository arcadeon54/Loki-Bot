# Antigravity (agy) runtime scratch. The DURABLE customizations —
# .agents/rules, .agents/skills, .agents/agents, .agents/hooks.json — are
# tracked on purpose; only the per-run orchestration metadata is ignored.
.agents/*_*/
.agents/ORIGINAL_REQUEST.md
.agents/DISPATCH.md
.agents/BRIEFING.md
.agents/DEAD_ENDS.md
.agents/GATE_STATUS.md
.agents/progress.md
