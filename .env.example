# =============================================================================
#  PROJECT: L.O.K.I. [Learning Oriented Kinetic Intelligence]
#  Configuration File
# =============================================================================
#  INSTRUCTIONS:
#    1. Rename this file from ".env.example" to ".env"
#    2. Fill in the values below
#    3. DO NOT share this file — it contains secret keys!
# =============================================================================


# ─── DISCORD BOT TOKEN ───────────────────────────────────────────────────────
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here


# ─── LLM PROVIDER ────────────────────────────────────────────────────────────
# Choose ONE of: "openai" or "local"
#
#   "openai"  →  Uses ChatGPT (requires OPENAI_API_KEY)
#   "local"   →  Uses a locally-hosted LLM (LM Studio, Ollama, etc.)
#
LLM_PROVIDER=openai


# ─── OPENAI / CHATGPT SETTINGS ───────────────────────────────────────────────
# Only needed if LLM_PROVIDER=openai
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o


# ─── LOCAL LLM SETTINGS ──────────────────────────────────────────────────────
# Only needed if LLM_PROVIDER=local
# This should point to your local LLM's OpenAI-compatible API endpoint
#
# Examples:
#   LM Studio:               http://localhost:1234/v1
#   Ollama:                   http://localhost:11434/v1
#   text-generation-webui:    http://localhost:5000/v1
#
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=local-model


# ─── FALLBACK LLM (e.g., Groq for cheap routing) ────────────────────────────
# Used for intent classification, cheap tasks, and voice transcription (Whisper)
# Get a free key from https://console.groq.com/
FALLBACK_LLM_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
FALLBACK_LLM_API_KEY=your_groq_api_key_here


# ─── GOOGLE GEMINI API KEY (for image/GIF recognition) ───────────────────────
# This is FREE! Get it from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ─── ELEVENLABS TTS ──────────────────────────────────────────────────────────
# Optional — high-quality text-to-speech for voice responses
# Get a free key from https://elevenlabs.io/
# Falls back to edge-tts (free, unlimited) if not configured
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here


# ─── MEMORY SETTINGS ─────────────────────────────────────────────────────────
# Path to the SQLite database file (stores conversation memory)
MEMORY_DB_PATH=loki_memory.db

# How many past messages to include as context when Loki replies
CONTEXT_MESSAGE_COUNT=50


# ─── CHROMADB / RAG DEEP MEMORY ──────────────────────────────────────────────
# Optional — enables deep memory search across full conversation history
# Requires a running ChromaDB instance (Docker recommended)
CHROMADB_HOST=localhost
CHROMADB_PORT=8100


# ─── TAVILY WEB SEARCH ───────────────────────────────────────────────────────
# Optional — enables real-time web search for factual questions
# Get a free key from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here


# ─── DOWNLOAD SETTINGS ───────────────────────────────────────────────────────
# Channel ID where download results are posted (right-click channel → Copy Channel ID)
DOWNLOAD_CHANNEL_ID=0

# Directory where downloaded media files are saved
DOWNLOAD_DIR=downloads

# Self-hosted Cobalt instance URL for watermark-free downloads (optional)
COBALT_URL=http://localhost:9000

# Public base URL for files too large to upload to Discord (optional)
# This should point to an nginx/file server serving the downloads directory
MEDIA_BASE_URL=

# User ID whose TikTok/Instagram links are auto-downloaded (optional)
AUTO_DOWNLOAD_USER_ID=0

# Paths to yt-dlp and ffmpeg binaries
YTDLP_BIN=/usr/local/bin/yt-dlp
FFMPEG_BIN=/usr/bin/ffmpeg


# ─── BOT-TO-BOT COORDINATION ─────────────────────────────────────────────────
# Optional — for coordinating with other bots (e.g., Miss-T) via shared state
MISST_BOT_USER_ID=0
SHARED_STATE_PATH=~/bot-shared-state/loki_state.json


# ─── CLAUDE CODE INTEGRATION ─────────────────────────────────────────────────
# Optional — enables /cc slash command for Claude Code integration
# Requires claude CLI installed and authenticated
CLAUDE_BIN=claude
CLAUDE_WORKSPACE=~
CLAUDE_TIMEOUT=300


# ─── DEFAULT PERSONALITY / SYSTEM PROMPT ─────────────────────────────────────
# This is the default persona for servers that haven't set a custom one.
# Server admins can override this with /set_personality in their server.
SYSTEM_PROMPT=You are Loki, the God of Mischief. You are witty, clever, and always ready with a sarcastic quip. You help people but never miss a chance for mischief.


# ─── SELF-LEARNING PERSONALITY ────────────────────────────────────────────────
# Path to the file where Loki writes personality learnings
LOKI_LEARNED_FILE=loki_learned.md
