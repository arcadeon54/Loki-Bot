# Loki .env — copy to .env and fill in. NEVER commit the real .env.

# ─── Core ─────────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
LLM_PROVIDER=openai                # openai | local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=local-model
FALLBACK_LLM_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
FALLBACK_LLM_API_KEY=
GEMINI_API_KEY=                    # image/GIF recognition
SYSTEM_PROMPT=You are Loki, the God of Mischief.
OWNER_USER_ID=                     # Discord user id of the Boss
CREW_USER_IDS=                     # comma-separated Discord ids

# ─── Joplin memory (July 2026) ────────────────────────────────────────────────
# Data API exposed by the loki-joplin-api sidecar container
JOPLIN_API_URL=http://127.0.0.1:41184
JOPLIN_API_TOKEN=                  # must match the sidecar's JOPLIN_API_TOKEN
LOKI_NOTEBOOK=Loki                 # Loki's own notebook namespace

# ─── Telegram (July 2026) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                # from @BotFather; may also live in a Joplin note
TELEGRAM_OWNER_ID=                 # numeric Telegram user id (optional: first DM pairs)

# ─── Home Assistant ───────────────────────────────────────────────────────────
HA_URL=https://ha.ivn-group.cc     # HA runs on the NAS
HA_TOKEN=                          # long-lived access token
HA_NOTIFY_CHANNEL_ID=              # Discord channel for HA notifications
HA_WEBHOOK_PORT=9100

# ─── Work tracker (July 2026) ─────────────────────────────────────────────────
WORK_PERSON_ENTITY=person.kavaris
WORK_CONFIRM_MINUTES=90            # dwell needed to confirm a work session
WORK_MOVE_THRESHOLD_M=250
WORK_HOURLY_RATE=16
GOOGLE_SHEETS_CONFIG_ENTRY=        # HA google_sheets config entry id (optional)
JOBSITE_CHANNEL_ID=                # Discord channel for work announcements

# ─── Presence / lockout warnings (July 2026) ─────────────────────────────────
PRESENCE_BOSS_ENTITY=person.kavaris
PRESENCE_ROOMMATE_ENTITY=person.ammiel
PRESENCE_BOSS_NOTIFY=mobile_app_nokia_e23
PRESENCE_ROOMMATE_NOTIFY=mobile_app_nothing_phone
PRESENCE_COOLDOWN_MINUTES=20

# ─── Search / RAG ─────────────────────────────────────────────────────────────
SEARXNG_URL=http://127.0.0.1:8083
TAVILY_API_KEY=                    # web-search fallback
CHROMADB_HOST=localhost
CHROMADB_PORT=8100

# ─── Media / downloads (existing) ─────────────────────────────────────────────
DOWNLOAD_DIR=
COBALT_URL=http://localhost:9000
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
SEERR_URL=http://localhost:5055
SEERR_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Duplicate social-link guard ───────────────────────────────────────────────
DUPLICATE_LINK_DETECTION_ENABLED=true         # false disables the whole feature
DUPLICATE_LINK_RETENTION_DAYS=0               # 0 = keep original-link records forever
DUPLICATE_LINK_ESCALATION_WINDOW_DAYS=30      # days before a user's warning tone resets
DUPLICATE_LINK_WARNING_DELETE_AFTER=20        # seconds before Loki's warning self-deletes; 0 = never
DUPLICATE_LINK_CAPTION_MAX_CHARS=100          # leftover caption length still eligible for delete-as-dup
DUPLICATE_LINK_EXCLUDED_CHANNEL_IDS=          # comma-separated channel ids exempt from enforcement

# ─── Autonomous maintenance notifications ─────────────────────────────────────
MAINTENANCE_OPS_CHANNEL_ID=                   # ONE Discord channel — the canonical
                                              # maintenance feed (incidents, escalations,
                                              # approvals, recoveries, summaries).
                                              # Unset = fall back to the Boss's line.
MONITOR_SUMMARY_INTERVAL_SECS=86400           # maintenance summary cadence; 0 = off

# ─── Hermes/OpenRouter provider protection (hermes_guard) ─────────────────────
HERMES_WORKER_URL=                            # restricted Hermes bridge on razr
HERMES_WORKER_TOKEN=                          # bearer token for the bridge
HERMES_MAX_REQUESTS_PER_HOUR=6                # rolling window; circuit opens at the ceiling
HERMES_MAX_REQUESTS_PER_DAY=20                # rolling 24h window
HERMES_MAX_SPEND_USD_PER_DAY=5.00             # observed job cost; 0 disables (bridge ledger stays authoritative)
HERMES_GUARD_FAILURE_THRESHOLD=3              # consecutive failures before a non-billing open
HERMES_GUARD_COOLDOWN_SECS=1800               # first cooldown; doubles per failed probe
HERMES_GUARD_BILLING_COOLDOWN_SECS=21600      # quota/credit opens wait this long
HERMES_GUARD_COOLDOWN_MAX_SECS=21600          # doubling bound
